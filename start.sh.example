#!/usr/bin/env bash
set -euo pipefail

# Copy this file to start.sh (gitignored) and customize for your deployment,
# the same way you'd copy .env.example to .env. Then: chmod +x start.sh

# CONTAINER_NAME and PORT must match the service URL in
# traefik-dynamic/tslen-workhub.yml (Traefik routes to this container by
# name over Docker's network DNS, not via labels - see
# docker-compose.traefik.yml.example for why).
CONTAINER_NAME="${CONTAINER_NAME:-tslen-workhub}"
ENV_FILE=".env"
FULL_IMAGE="tslen-workhub:latest"
PORT="${PORT:-4004}"
DOCKER_NETWORK="${DOCKER_NETWORK:-tslen-net}"

# The Angular prod build's environment.prod.ts is generated at build time
# from this .env file (see packages/web/set-env.ts), and the Dockerfile
# copies .env into the web-build stage - a missing .env fails deep in the
# ng build log with a confusing error. Fail fast here instead.
if [ ! -f "${ENV_FILE}" ]; then
    echo "Missing ${ENV_FILE} - copy .env.example to ${ENV_FILE} and fill in this deployment's values, then re-run." >&2
    exit 1
fi

docker rm -f "${CONTAINER_NAME}" 2>/dev/null || true

docker build --build-arg APP_PORT="${PORT}" -t "${FULL_IMAGE}" .

docker run -d \
    --name "${CONTAINER_NAME}" \
    --restart unless-stopped \
    --network "${DOCKER_NETWORK}" \
    --add-host host.docker.internal:host-gateway \
    --env-file "${ENV_FILE}" \
    -v "./upload:/app/upload" \
    -v "./credentials:/app/credentials" \
    "${FULL_IMAGE}"
