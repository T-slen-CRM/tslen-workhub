{
  "name": "nest-tslen-workhub",
  "version": "0.0.1",
  "description": "Open source CRM system for small and medium businesses",
  "author": "Oleh Teslenko",
  "private": true,
  "license": "MIT",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:front": "cd packages/web && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "livekit:dev": "docker compose up -d livekit || echo 'LiveKit dev server not started (Docker unavailable?) - video calls will not work until it is running.'",
    "prestart:dev": "npm run livekit:dev",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run livekit:dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "restart": "npm run build && pm2 restart crm-nest && pm2 logs crm-nest",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./test/jest.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --detectOpenHandles",
    "test:unit": "jest --config ./test/jest-unit.json --detectOpenHandles",
    "one_test": "npm run test:unit users.controller.unit.spec.ts",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate migrations/$npm_config_name/migrations -d ./typeOrm.config.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d ./typeOrm.config.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d ./typeOrm.config.ts"
  },
  "dependencies": {
    "@google-apps/meet": "^0.3.0",
    "@google-cloud/local-auth": "^2.1.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.19",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/platform-socket.io": "^10.4.1",
    "@nestjs/platform-ws": "^10.2.10",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.19",
    "@slack/web-api": "^7.2.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^12.5.0",
    "googleapis": "^144.0.0",
    "handlebars": "^4.7.8",
    "livekit-server-sdk": "^2.13.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "server-destroy": "^1.0.1",
    "socket.io-client": "^4.7.5",
    "typeorm": "^0.3.20",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@automock/adapters.nestjs": "^2.1.0",
    "@automock/jest": "^2.1.0",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^16.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "^2.2.0"
  }
}
