# Copy to traefik-dynamic/tslen-workhub.yml (gitignored, same idea as
# .env.example -> .env) and replace the domain below with the one you
# pointed DNS at. Traefik's file provider watches this directory and
# picks up changes without a restart.
#
# The service URL's host ("tslen-workhub") must match start.sh's
# CONTAINER_NAME and its port must match PORT - Docker's embedded DNS
# resolves container names to their address on the shared tslen-net
# bridge network automatically.
http:
  routers:
    tslen-workhub:
      rule: "Host(`REPLACE_WITH_YOUR_DOMAIN`)"
      entrypoints:
        - websecure
      service: tslen-workhub
      tls:
        certResolver: letsencrypt
  services:
    tslen-workhub:
      loadBalancer:
        servers:
          - url: "http://tslen-workhub:4004"
